VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — only used by scripts/upload-trainer-sprites.mjs
# Find it in: Supabase Dashboard → Project Settings → API → service_role (secret)
# ⚠️  NEVER prefix this with VITE_ — it must never be bundled into the frontend
SUPABASE_SERVICE_KEY=your-service-role-key-here
